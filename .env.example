# Environment (dev, staging, production)
NODE_ENV=development

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Database URL for Prisma (same as Supabase Postgres connection string)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Redis Configuration (for BullMQ)
REDIS_URL=your_redis_url_here

# Razorpay Payment Gateway (Sandbox keys for dev/staging)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Telephony Provider (Sandbox/Test credentials)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Provider
WHATSAPP_API_KEY=test_key_here
WHATSAPP_API_SECRET=test_secret_here

CAPACITOR_SERVER_URL=your_deployed_web_app_url

# Email Provider
EMAIL_API_KEY=test_key_here

# NextAuth Secret (for session encryption)
NEXTAUTH_SECRET=generate_a_random_secret_here
NEXTAUTH_URL=http://localhost:3000
