# Environment (dev, staging, production)
NODE_ENV=development

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Database URL for Prisma (same as Supabase Postgres connection string)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Redis Configuration (for BullMQ)
REDIS_URL=your_redis_url_here

# Payment Gateway (Sandbox keys for dev/staging)
PAYMENT_GATEWAY_KEY=sandbox_key_here
PAYMENT_GATEWAY_SECRET=sandbox_secret_here

# Telephony Provider (Sandbox/Test credentials)
TELEPHONY_API_KEY=test_key_here
TELEPHONY_API_SECRET=test_secret_here

# WhatsApp Provider
WHATSAPP_API_KEY=test_key_here
WHATSAPP_API_SECRET=test_secret_here

# Email Provider
EMAIL_API_KEY=test_key_here

# NextAuth Secret (for session encryption)
NEXTAUTH_SECRET=generate_a_random_secret_here
NEXTAUTH_URL=http://localhost:3000
