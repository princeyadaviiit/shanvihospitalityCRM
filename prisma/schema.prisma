// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Multi-tenant: each company is a separate tenant
model Company {
  id        String   @id @default(cuid())
  name      String
  gstNumber String?  @map("gst_number")
  currency  String   @default("INR") // Default currency: INR or USD
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users          User[]
  leads          Lead[]
  leadNotes      LeadNote[]
  itineraries    Itinerary[]
  bookings       Booking[]
  auditLogs      AuditLog[]
  employees      Employee[]
  salaryPayments SalaryPayment[]
  customPackages CustomPackage[]

  @@map("companies")
}

// Application user linked to Supabase Auth
model User {
  id          String   @id @default(cuid())
  supabaseUid String   @unique @map("supabase_uid") // Links to Supabase Auth user
  companyId   String   @map("company_id")
  name        String
  email       String
  role        UserRole
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedLeads Lead[]        @relation("AssignedAgent")
  leadNotes     LeadNote[]
  ledgerEntries LedgerEntry[]
  calls         Call[]
  targets       Target[]

  @@index([companyId])
  @@index([supabaseUid])
  @@map("users")
}

enum UserRole {
  admin
  staff_agent
  accounts
}

enum LeadStatus {
  ENQUIRY
  IN_PROGRESS
  CONFIRMED
  MISSED
}

enum LineItemCategory {
  ACCOMMODATION
  TRANSPORT
  ACTIVITY
  MEALS
  OTHER
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Lead {
  id              String     @id @default(cuid())
  companyId       String     @map("company_id")
  name            String
  email           String?
  phone           String
  destination     String
  paxCount        Int        @default(1) @map("pax_count")
  status          LeadStatus @default(ENQUIRY)
  quotedPrice     Float      @default(0) @map("quoted_price")
  currency        String     @default("INR")
  source          String     @default("manual")
  assignedAgentId String?    @map("assigned_agent_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  // Relations
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedAgent User?      @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  notes         LeadNote[]
  itinerary     Itinerary?
  booking       Booking?
  calls         Call[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, assignedAgentId])
  @@map("leads")
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  userId    String   @map("user_id")
  companyId String   @map("company_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([companyId])
  @@map("lead_notes")
}

model Itinerary {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  leadId      String    @unique @map("lead_id")
  title       String
  destination String
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  markup      Float     @default(0)
  totalCost   Float     @default(0) @map("total_cost")
  finalPrice  Float     @default(0) @map("final_price")
  currency    String    @default("INR")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead    Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  days    ItineraryDay[]
  booking Booking?

  @@index([companyId])
  @@map("itineraries")
}

model ItineraryDay {
  id          String   @id @default(cuid())
  itineraryId String   @map("itinerary_id")
  dayNumber   Int      @map("day_number")
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  itinerary Itinerary          @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  lineItems ItineraryLineItem[]

  @@index([itineraryId])
  @@map("itinerary_days")
}

model ItineraryLineItem {
  id          String           @id @default(cuid())
  dayId       String           @map("day_id")
  category    LineItemCategory
  description String
  cost        Float            @default(0)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  // Relations
  day ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
  @@map("itinerary_line_items")
}

model Booking {
  id            String        @id @default(cuid())
  companyId     String        @map("company_id")
  leadId        String        @unique @map("lead_id")
  itineraryId   String        @unique @map("itinerary_id")
  bookingNumber String        @unique @map("booking_number")
  status        BookingStatus @default(CONFIRMED)
  totalAmount   Float         @map("total_amount")
  currency      String        @default("INR")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead           Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  itinerary      Itinerary      @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  ledgerEntries  LedgerEntry[]
  invoices       Invoice[]
  razorpayOrders RazorpayOrder[]

  @@index([companyId])
  @@map("bookings")
}

// ── Phase 3: Financial Ledger ─────────────────────────────────────────────────

enum LedgerEntryType {
  DEPOSIT
  PAYMENT
  SUPPLIER_COST
  REFUND
}

enum InvoiceStatus {
  DRAFT
  ISSUED
}

// Every financial transaction for a booking — multi-currency, append-only
model LedgerEntry {
  id           String          @id @default(cuid())
  bookingId    String          @map("booking_id")
  companyId    String          @map("company_id")
  type         LedgerEntryType
  amount       Float
  currency     String          @default("INR")
  description  String
  recordedById String          @map("recorded_by_id")
  createdAt    DateTime        @default(now()) @map("created_at")

  // Relations
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recordedBy User    @relation(fields: [recordedById], references: [id])

  @@index([bookingId])
  @@index([companyId])
  @@map("ledger_entries")
}

// Append-only audit trail — never updated or deleted, per security.md §9
model AuditLog {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  actorId     String   @map("actor_id")
  actorRole   String   @map("actor_role")
  action      String   // e.g. "ledger.create", "invoice.generate"
  entityType  String   @map("entity_type") // e.g. "LedgerEntry", "Invoice"
  entityId    String   @map("entity_id")
  beforeState String?  @map("before_state") // JSON string
  afterState  String   @map("after_state")  // JSON string
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([entityId])
  @@map("audit_logs")
}

// GST-compliant invoice linked to a booking
model Invoice {
  id            String        @id @default(cuid())
  bookingId     String        @map("booking_id")
  companyId     String        @map("company_id")
  invoiceNumber String        @unique @map("invoice_number")
  gstNumber     String?       @map("gst_number")
  subtotal      Float
  gstAmount     Float         @map("gst_amount")
  totalAmount   Float         @map("total_amount")
  currency      String        @default("INR")
  status        InvoiceStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([companyId])
  @@map("invoices")
}

// Tracks Razorpay gateway orders for idempotent webhook processing
model RazorpayOrder {
  id              String   @id @default(cuid())
  bookingId       String   @map("booking_id")
  companyId       String   @map("company_id")
  razorpayOrderId String   @unique @map("razorpay_order_id")
  razorpayPaymentId String? @map("razorpay_payment_id")
  amount          Float
  currency        String   @default("INR")
  status          String   @default("CREATED") // CREATED | PAID | FAILED
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([companyId])
  @@map("razorpay_orders")
}

// ── Phase 4: Telephony & Performance Tracking ─────────────────────────────────

// Call log — click-to-call metadata
model Call {
  id           String   @id @default(cuid())
  companyId    String   @map("company_id")
  leadId       String   @map("lead_id")
  agentId      String   @map("agent_id")
  duration     Int?     @default(0) // Duration in seconds
  recordingUrl String?  @map("recording_url")
  twilioCallSid String? @unique @map("twilio_call_sid")
  status       String?  @default("initiated") // initiated | in-progress | completed | failed
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  lead  Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent User @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([leadId])
  @@index([agentId])
  @@map("calls")
}

// Monthly performance targets per agent
model Target {
  id            String   @id @default(cuid())
  companyId     String   @map("company_id")
  agentId       String   @map("agent_id")
  month         DateTime // First day of target month
  revenueTarget Float    @default(0) @map("revenue_target")
  bookingTarget Int      @default(0) @map("booking_target")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  agent User @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, month])
  @@index([companyId])
  @@map("targets")
}

// ── Phase 5: HRMS & Employee Payroll ─────────────────────────────────────────

model Employee {
  id             String          @id @default(cuid())
  companyId      String          @map("company_id")
  name           String
  email          String
  phone          String
  department     String          // Sales, Operations, Tour Planning, Accounts, Management
  designation    String          // e.g. "Senior Tour Consultant", "Key Tour Planner"
  joiningDate    DateTime        @default(now()) @map("joining_date")
  baseSalary     Float           @default(0) @map("base_salary")
  allowances     Float           @default(0)
  deductions     Float           @default(0)
  netSalary      Float           @default(0) @map("net_salary")
  bankName       String?         @map("bank_name")
  accountNumber  String?         @map("account_number")
  ifscCode       String?         @map("ifsc_code")
  panNumber      String?         @map("pan_number")
  status         String          @default("ACTIVE") // ACTIVE, ON_LEAVE, RESIGNED
  commissionRate Float           @default(0) @map("commission_rate")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  // Relations
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salaryPayments SalaryPayment[]

  @@index([companyId])
  @@map("employees")
}

model SalaryPayment {
  id             String   @id @default(cuid())
  employeeId     String   @map("employee_id")
  companyId      String   @map("company_id")
  month          String   // e.g. "September 2026"
  baseAmount     Float    @map("base_amount")
  bonusAmount    Float    @default(0) @map("bonus_amount")
  deductions     Float    @default(0)
  netPaid        Float    @map("net_paid")
  paymentDate    DateTime @default(now()) @map("payment_date")
  paymentMode    String   @default("NEFT") // NEFT, IMPS, UPI, CHEQUE, CASH
  paymentStatus  String   @default("PAID") // PAID, PENDING, PROCESSING
  transactionRef String?  @map("transaction_ref")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@map("salary_payments")
}

model CustomPackage {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  title       String
  slug        String
  destination String
  country     String   @default("India")
  duration    String
  daysCount   Int      @default(1) @map("days_count")
  priceFrom   String?  @map("price_from")
  category    String   // JSON array string
  highlights  String   // JSON array string
  description String
  itinerary   String?  // JSON array string
  inclusions  String?  // JSON array string
  exclusions  String?  // JSON array string
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("custom_packages")
}

